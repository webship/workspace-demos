{
  "name": "@webship.co/workspace-demos",
  "version": "1.0.11",
  "description": "The Demos workspace for Webship Workspace: the `demos/` folder (type sites), its settings file, its 27 commands, its docs and its AI items (an agent, a skill, a command and a prompt, each in the folder of its kind), activated as a plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-demos.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "docs",
    "features",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "demos",
    "label": "Demos",
    "needs": [
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "suggests": {
      "commands": [
        {
          "command": "composer",
          "hint": "https://getcomposer.org/download/"
        }
      ]
    },
    "workspace": {
      "key": "demos",
      "settingsTemplate": "config/workspace.demos.settings.yml",
      "files": [
        "commands/cmd-cucumber11-0-x-project.sh",
        "commands/cmd-drupal10-3-x-recommended-project.sh",
        "commands/cmd-drupal10-recommended-project.sh",
        "commands/cmd-drupal11-0-x-recommended-project.sh",
        "commands/cmd-drupal11-4-0-recommended-project.sh",
        "commands/cmd-drupal11-4-x-recommended-project.sh",
        "commands/cmd-drupal11-recommended-project.sh",
        "commands/cmd-drupal12-recommended-project.sh",
        "commands/cmd-drupalcms2-1-0-project.sh",
        "commands/cmd-drupalcms2-x-project.sh",
        "commands/cmd-tools-add-users.sh",
        "commands/cmd-tools-backup-demo.sh",
        "commands/cmd-tools-cancel-users.sh",
        "commands/cmd-tools-checks.sh",
        "commands/cmd-tools-clone.sh",
        "commands/cmd-tools-git-change-filemode-to-false.sh",
        "commands/cmd-tools-hostnames.sh",
        "commands/cmd-tools-reclaim.sh",
        "commands/cmd-tools-remove.sh",
        "commands/cmd-tools-screen.sh",
        "commands/cmd-tools-testing.sh",
        "commands/cmd-tools-update-all.sh",
        "commands/cmd-webship11-0-0-project.sh",
        "commands/cmd-webship11-0-x-project.sh",
        "commands/cmd-webships2-0-0-project.sh",
        "commands/cmd-webships2-0-x-project.sh",
        "commands/cmd-webships3-0-x-project.sh"
      ],
      "docs": [
        "docs/AGENTS.md",
        "docs/CLAUDE.md",
        "docs/README.md"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/demos-site-builder.md"
      ],
      "skills": [
        "ai/skills/demos-workflow"
      ],
      "commands": [
        "ai/commands/demos-build.md"
      ],
      "prompts": [
        "ai/prompts/demos-build-a-demo.md"
      ]
    },
    "features": [
      "features/demos.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
